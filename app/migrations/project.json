{
  "name": "migrations",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "app/migrations",
  "tags": [],
  "targets": {
    "build:default": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": "{projectRoot}/main.go",
        "outputPath": "{projectRoot}/app"
      }
    },
    "serve": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/main.go"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    },
    "up": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/main.go up"
      }
    },
    "down": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/main.go down"
      }
    },
     "drop": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/main.go drop"
      }
    },
    "docker": {
      "command": "cd {projectRoot}/ && make docker"
    },
    "build": {
      "command": "cd {projectRoot}/ && GOOS=linux GOARCH=arm64 go build -o app ."
    },
    "build:mac:amd64": {
      "command": "cd {projectRoot}/ && GOOS=linux GOARCH=amd64 go build -o app ."
    }
  }
}
