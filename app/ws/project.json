{
  "name": "ws",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "app/ws",
  "tags": [],
  "targets": {
    "build:default": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": "{projectRoot}/main.go",
        "outputPath": "{projectRoot}/app"
      }
    },
    "serve": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/main.go",
        "cmd": "gow"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    },
    "docker": {
      "command": "cd {projectRoot}/ && make docker"
    },
    "build": {
      "command": "cd {projectRoot}/ && GOOS=linux GOARCH=$(go env GOARCH) go build -o app ."
    }
  }
}
